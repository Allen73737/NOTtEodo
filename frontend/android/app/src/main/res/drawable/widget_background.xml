<?xml version="1.0" encoding="utf-8"?>
<!-- Card widget: warm black with an oxblood glow rising from the top-right corner. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#0E0B0B"
                android:startColor="#1C1213"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="1.0"
                android:centerY="0.0"
                android:endColor="#008E2433"
                android:gradientRadius="220dp"
                android:startColor="#668E2433"
                android:type="radial" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#2E2022" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
