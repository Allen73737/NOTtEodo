# ==============================================================================
# NOTtEodo Production Backend Environment Configuration (.env)
# ==============================================================================
# CRITICAL SECURITY NOTE:
# 1. Never commit production .env files to version control.
# 2. Never expose SUPABASE_SERVICE_ROLE_KEY or GROQ_API_KEY to the frontend client.
# ==============================================================================

# 1. Supabase Cloud / Self-Hosted Instance
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. High-Performance Scoped AI (Groq LLaMA 3.3 70B Versatile)
# Server-side edge functions only.
GROQ_API_KEY=gsk_your_groq_api_key_here

# 3. Document & Asset Cloud Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=notteodo_preset

# 4. Security & Crypto Salt Configurations
VAULT_PEPPER_SECRET=change_me_to_a_64_character_random_hex_string_for_vault_peppering
RATE_LIMIT_GLOBAL_PER_MINUTE=120

# 5. Sovereign Sanctuary Predefined Administrator Credentials
ADMIN_EMAIL=admin@notteodo.sanctuary
ADMIN_PASSWORD=Sanctuary@MasterKey2026!
