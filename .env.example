# ==============================================================================
# NOTtEodo Sanctuary Enterprise Deployment Environment Configuration
# ==============================================================================
# Copy this file to .env before deploying:
#   cp .env.example .env
# ==============================================================================

# Application Environment Flavor (production | staging | development)
APP_ENV=production

# Web Server Configuration
# The web container binds to 127.0.0.1 by default; put a TLS reverse proxy in front.
# Set WEB_BIND=0.0.0.0 only if TLS is terminated elsewhere on this host.
WEB_PORT=8080
WEB_BIND=127.0.0.1

# Database Configuration (PostgreSQL 15 + pgvector)
DB_PORT=5432
POSTGRES_DB=notteodo
POSTGRES_USER=postgres
# Required. Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Supabase Cloud / Self-Hosted Configuration (Optional for cloud sync)
SUPABASE_URL=
# The anon key is public by design (it ships in the web app); RLS protects the data.
SUPABASE_ANON_KEY=
# Server-side only (edge functions). Never put this in the web app or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Edge functions: comma-separated web origins allowed to call them (CORS).
ALLOWED_ORIGINS=https://your-app.example.com

# LLM & Scoped AI (Groq LLaMA 3.3 70B Versatile for Edge Functions)
GROQ_API_KEY=

# Cloud Storage & Media Presets (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=notteodo_preset

# Note: there is no server-side vault secret. Vault keys are derived on the device
# (zero-knowledge); the server never sees PINs, passphrases or keys.
