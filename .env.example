# ==============================================================================
# NOTtEodo Sanctuary Enterprise Deployment Environment Configuration
# ==============================================================================
# Copy this file to .env before deploying:
#   cp .env.example .env
# ==============================================================================

# Application Environment Flavor (production | staging | development)
APP_ENV=production

# Web Server Configuration
WEB_PORT=8080

# Database Configuration (PostgreSQL 15 + pgvector)
DB_PORT=5432
POSTGRES_DB=notteodo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_strong_entropy_password_in_production

# Supabase Cloud / Self-Hosted Configuration (Optional for cloud sync)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM & Scoped AI (Groq LLaMA 3.3 70B Versatile for Edge Functions)
GROQ_API_KEY=

# Cloud Storage & Media Presets (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=notteodo_preset

# Security, Audit Ledger, & Peppering Secret
VAULT_PEPPER_SECRET=replace_with_64_character_hex_string_for_vault_peppering
RATE_LIMIT_GLOBAL_PER_MINUTE=120
